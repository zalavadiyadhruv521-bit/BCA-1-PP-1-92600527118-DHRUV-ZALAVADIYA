#include <stdio.h>
#include <conio.h>

void main()
{
	char ch;
	clrscr();

	printf("enter a character : ");
	scanf("%c",&ch);

	if (ch >= 'A' && ch <= 'Z')
	printf("character is upper case");
	else if (ch >= 'a' && ch <= 'z')
	printf("character is lower case");
	else
	printf("it is not an alphabet");

	getch();

}